#!/sbin/openrc-run
# openimages.cloud: let sshd accept key logins for cloud-init users.
#
# cloud-init locks the default user's password with "!" in /etc/shadow.
# Without PAM (musl), OpenSSH treats "!" as a locked account and refuses
# even public-key logins ("User alpaquita not allowed because account is
# locked"). Turn "!" into "*": the password stays unusable, but sshd no
# longer sees the account as locked. Ordered after the cloud-init stages
# that create the users.

description="Unlock cloud-init users for public-key SSH logins"

depend() {
	after cloud-init cloud-config cloud-final
	before local
}

start() {
	ebegin "Unlocking cloud-init users for SSH key logins"
	sed -i -E 's/^([^:]+):!+:/\1:*:/' /etc/shadow
	eend $?
}
